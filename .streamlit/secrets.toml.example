# Copy this file to .streamlit/secrets.toml and fill in national team values.
# NEVER commit the real secrets.toml — it is already in .gitignore.
# On Streamlit Community Cloud, paste these same keys into
# "Settings -> Secrets" for the deployed app instead of using a file.

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"

# This is the powerful key — bypasses Row Level Security entirely.
# It must ONLY ever live here, in the National App's own secrets.
# Never put this key in state_app, never commit it, never share it.
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# Used for the login screen itself (Supabase Auth sign-in uses the anon key
# flow even for admins — the service_role key above is used for subsequent
# privileged data operations once the national role is confirmed).
SUPABASE_ANON_KEY = "your-anon-key"
